# Region: ru | com — picks sh-development.<region> links (set by the deploy matrix in prod)
REGION=ru
PORT=8891
AUTH_URL=https://auth-center.example.com
AUTH_INTERNAL=http://localhost:8886
APP_URL=https://blur.example.com
APP_TOKEN=your-app-token-here
SECRET_KEY=change-me-in-production
DB_PATH=blur.db
MEDIA_DIR=./media
# S3-compatible storage (Yandex example; for Cloudflare R2 use
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_PUBLIC_URL=<custom domain of the bucket>)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=your-bucket
S3_KEY=your-access-key-id
S3_SECRET=your-secret-access-key
S3_PUBLIC_URL=https://storage.yandexcloud.net/your-bucket
